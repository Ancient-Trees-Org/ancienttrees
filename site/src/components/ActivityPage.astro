---
// /activity: the hearts other people gave your photographs (Hidde,
// 2026-11-22: "kun je ook zien als je een hartje krijgt wie je dat heeft
// gegeven?"; the bell "voor nu is het ok"; he expects a real activity feed
// with the people you follow later, in the menu). Convention: Instagram's
// Activity and Strava's notifications, bundled per photograph ("Miguel P. and
// 2 others gave your photograph of ... a heart"), New above Earlier, the
// photograph's thumbnail at the row's end; a tap opens the tree. Design:
// drafts/design-2026-11-22-heart-who/product.html.
//
// Signed in only, filled in the browser from my_photo_activity()
// (supabase/photo-hearts-who.sql); opening it calls activity_seen(), which
// takes the bell's dot away on every device. Not for Google (noindex): it is
// yours alone.
import Base from "../layouts/Base.astro";
import { ui } from "../lib/i18n";
import { chrome } from "../lib/ui-strings";
import { BASE_URL } from "../lib/schema";
import { SUPABASE_URL, SUPABASE_KEY } from "../lib/site-config";
import { visitorCards, cardsJson } from "../lib/visitor-cards";
import { AGO_FN } from "../lib/time-ago-js";

interface Props { lang?: string }
const { lang = "en" } = Astro.props as Props;
const u = ui(lang);
const t = chrome(lang);
const path = lang === "en" ? "/activity" : `/${lang}/activity`;
const data = cardsJson(await visitorCards(lang));
const words = {
  one: u.activityOne, two: u.activityTwo, more: u.activityMore,
  fresh: u.activityNew, earlier: u.activityEarlier, empty: u.activityEmpty, anon: u.noteVisitor,
};
const js = `<script>
(function () {
  ${AGO_FN}
  var SB = ${JSON.stringify(SUPABASE_URL)}, KEY = ${JSON.stringify(SUPABASE_KEY)};
  var W = ${JSON.stringify(words)};
  var cards = JSON.parse(document.getElementById('act-data').textContent || '{}');
  var list = document.getElementById('act-list');
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return '&#' + c.charCodeAt(0) + ';'; }); }
  function line(r, tree) {
    var names = r.names || [], n = Number(r.hearts) || 0;
    var a = '<b>' + esc(names[0] || W.anon) + '</b>';
    var t = '<b>' + esc(tree) + '</b>';
    if (n <= 1) return W.one.replace('{a}', a).replace('{t}', t);
    if (n === 2 && names[1]) return W.two.replace('{a}', a).replace('{b}', '<b>' + esc(names[1]) + '</b>').replace('{t}', t);
    return W.more.replace('{a}', a).replace('{n}', '<b>' + (n - 1) + '</b>').replace('{t}', t);
  }
  function faces(r) {
    var names = r.names || [], avs = r.avatars || [];
    var out = '';
    for (var i = 0; i < Math.max(1, Math.min(2, names.length)); i++) {
      var nm = names[i] || W.anon, av = avs[i];
      out += av && /^https:/.test(av)
        ? '<span class="act-face" style="background-image:url(' + esc(av.replace(/[()'"]/g, '')) + ')"></span>'
        : '<span class="act-face">' + esc(nm.charAt(0).toUpperCase()) + '</span>';
    }
    return out;
  }
  function row(r) {
    var c = cards[r.tree_id] || null;
    var img = c ? (c.s[String(r.photo_id).toLowerCase()] || c.p) : '';
    var href = c ? c.u : '#';
    return '<li><a class="act-row' + (r.is_new ? ' is-new' : '') + '" href="' + esc(href) + '">'
      + '<span class="act-faces">' + faces(r) + '</span>'
      + '<span class="act-text">' + line(r, c ? c.n : '') + ' <span class="act-when">' + esc(atAgo(r.latest_at, false)) + '</span></span>'
      + (img ? '<img class="act-ph" src="' + esc(img) + '" alt="" loading="lazy">' : '')
      + '</a></li>';
  }
  function paint(rows) {
    var fresh = rows.filter(function (r) { return r.is_new; });
    var old = rows.filter(function (r) { return !r.is_new; });
    var html = '';
    if (fresh.length) html += '<li class="act-day">' + esc(W.fresh) + '</li>' + fresh.map(row).join('');
    if (old.length) html += '<li class="act-day">' + esc(W.earlier) + '</li>' + old.map(row).join('');
    list.innerHTML = html || '<li class="act-empty">' + esc(W.empty) + '</li>';
  }
  function go(s) {
    var h = { 'apikey': KEY, 'Authorization': 'Bearer ' + s.access_token, 'Content-Type': 'application/json' };
    fetch(SB + '/rest/v1/rpc/my_photo_activity', { method: 'POST', headers: h, body: '{"n":60}' })
      .then(function (r) { return r.ok ? r.json() : []; })
      .then(function (rows) {
        paint(rows || []);
        // Seen once it is on screen: the dot goes on every device.
        fetch(SB + '/rest/v1/rpc/activity_seen', { method: 'POST', headers: h, body: '{}' }).then(function () {
          document.querySelectorAll('header.bar .bell-dot').forEach(function (d) { d.hidden = true; });
        }).catch(function () {});
      })
      .catch(function () { paint([]); });
  }
  function start() {
    var C = window.atCollection;
    var ask = function () { if (window.atOpenSignIn) window.atOpenSignIn(); };
    if (C && C.gate) C.gate(go, ask); else ask();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
})();
</script>`;
---
<Base
  title={t.activity}
  description={u.activityIntro}
  canonical={`${BASE_URL}${path}`}
  lang={lang}
  headExtra={'<meta name="robots" content="noindex">'}>
<main class="act-page">
  <h1>{t.activity}</h1>
  <p class="answer-first">{u.activityIntro}</p>
  <ul class="act-list" id="act-list"><li class="act-wait"><span class="vp-spin" role="status"></span></li></ul>
</main>
<script type="application/json" id="act-data" set:html={data}></script>
<Fragment slot="scripts" set:html={js} />
</Base>
