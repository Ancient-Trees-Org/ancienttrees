---
// The intro under the place head (PlaceHead.astro): three lines, Read more,
// then the white box (ambassador) and whatever the page adds in its slot.
// One block on every place page, so the city page's look reaches the
// country page and /explore (Hidde, 2026-11-22). Read more is sheet-js.ts.
interface Props {
  text: string;
  readMore: string;
  /** /explore only: hooks for its text and its ambassador box (ex-*). */
  live?: boolean;
}
const { text, readMore, live } = Astro.props as Props;
---
{/* /explore's world line is one sentence, so it starts open (no Read more);
    a searched country's intro closes it again (map.ts _headFor). */}
<div class={live ? "city-intro is-open" : "city-intro"} id={live ? "ex-intro" : undefined}>
  <p class="lede">{text}</p>
  <button type="button" class="city-intro-more">{readMore}</button>
  {live && <div id="ex-box"></div>}
  <slot />
</div>
