---
// Somebody else's profile, when they made it public: /profile?u=<user id>.
//
// Reference: Polarsteps' public profile (polarsteps.com/<name>), and our own
// /account. Hidde, 2026-10-19, looking at the design page: "ja dit ziet er goed
// uit", and on the two lists: "die kunnen gewoon gelijk blijven toch?". So this
// is /account as a visitor sees it: the same skeleton, the same header row with
// Follow where your own gear sits, the same badges, the same two tabs and the
// same grid, and the same map of the trees beside it.
//
// WHO MAY BE SEEN is the server's answer, never this page's: public_profile()
// (supabase/public-profiles.sql) returns the profile only while its owner's
// "Public profile" switch is on, and null otherwise. Private, unknown and
// not-yet-migrated all read the same: "This profile is private."
//
// What it never shows, because the function never returns it: the day a tree
// was ticked, a private sighting photograph, an email address.
//
// Noindexed and out of the sitemap: during Google recovery no new page type
// enters the index, and a person's page is not a search landing.
import Base from "../layouts/Base.astro";
import { BASE_URL } from "../lib/schema";
import { SUPABASE_URL, SUPABASE_KEY } from "../lib/site-config";
import { TREE_ACTIONS_JS } from "../lib/tree-actions-js";
import { myTreesMapScript, mapHead } from "../lib/map";
import { icon } from "../lib/icons";
import { SHEET_JS } from "../lib/sheet-js";
import { EARLY_ADOPTER_UNTIL } from "../lib/early-adopter";
import { ui } from "../lib/i18n";
import Sheet from "../components/Sheet.astro";

const canonical = `${BASE_URL}/profile`;
const SEAL = icon("seal-check", "fill", "ic").replace(/\n/g, "").replace(/'/g, "");
const LOCK = icon("lock-simple", "bold", "ic");
const t = ui("en");
---
<Base
  title="Profile"
  description="Trees somebody collected on Ancient Trees."
  canonical={canonical}
  headExtra={'<meta name="robots" content="noindex, nofollow">' + mapHead()}
  footer={false}
>
<div class="split">
  <aside class="panel" id="sheet">
  <div class="sheet-grab"><div class="panel-head">

  <section id="pp-private" class="acct-card" hidden>
    <p class="pp-private"><Fragment set:html={LOCK} />This profile is private.</p>
  </section>

  <section id="pp-in" class="profile-head" hidden>
    <div class="profile-top">
      <span class="profile-avatar" id="pp-avatar" aria-hidden="true"></span>
      <div class="profile-who">
        <div class="profile-name"><h1 id="pp-name"></h1><img class="profile-flag" id="pp-flag" alt="" width="20" height="20" hidden /></div>
        {/* Each number opens its list (Hidde, 2026-11-22, "4 ja"; AllTrails:
            "Click the number next to 'Followers'"; the app's PersonProfile). */}
        <p class="profile-follow"><button type="button" class="pp-count" data-list="followers"><b id="pp-followers">0</b> followers</button><button type="button" class="pp-count" data-list="following"><b id="pp-following">0</b> following</button></p>
      </div>
      {/* Follow where the gear sits on your own profile (Polarsteps). Your
          own public profile shows no button: you do not follow yourself. */}
      <button type="button" class="profile-follow-btn" id="pp-follow" hidden>Follow</button>
      {/* Report and Block behind the ..., as AllTrails' and Instagram's on a
          profile (Hidde, 2026-11-22, "Ja, bouw het"); the app's PersonActions.
          Not on your own profile; signed out, it asks you to sign in. */}
      <button type="button" class="pp-more" id="pp-more" aria-label="More" hidden><Fragment set:html={icon("dots-three", "bold")} /></button>
    </div>
    <div class="profile-badges">
      <p class="profile-ambassador" id="pp-ambassador" hidden></p>
      <p class="profile-early" id="pp-early" hidden><Fragment set:html={icon("sparkle", "fill", "ic")} /><span>Early adopter</span></p>
    </div>
  </section>
  </div></div>

  <div class="sheet-body">
  <section class="acct-lanes" id="pp-lanes" hidden>
    <div class="lane-picker" role="tablist" aria-label="Their lists">
      <button type="button" id="lane-mine" class="lane on" role="tab" aria-selected="true" aria-controls="pane-mine">Collected</button>
      <button type="button" id="lane-saved" class="lane" role="tab" aria-selected="false" aria-controls="pane-saved">Want to visit</button>
    </div>
    <div id="pane-mine" role="tabpanel" aria-labelledby="lane-mine">
      <ul id="visited-list" class="saved-list" hidden></ul>
      <p id="mine-empty" class="pp-empty" hidden>No trees collected yet.</p>
    </div>
    <div id="pane-saved" role="tabpanel" aria-labelledby="lane-saved" hidden>
      <ul id="saved-list" class="saved-list" hidden></ul>
      <p id="saved-empty" class="pp-empty" hidden>No trees saved yet.</p>
    </div>
  </section>
  </div>
  </aside>
  {/* THE PICTURE, BIGGER (Hidde, 2026-11-16; CONVENTIONS.md "Tapping
      somebody's profile picture to see it bigger"): WhatsApp's and Facebook's
      way, the whole photograph on black in the viewer a tree photograph opens
      in (the same .photo-view dialog, PhotoFigure.astro), X, Escape, a click
      beside it or a drag down to close. No credit: it is their own picture.
      A letter avatar is not a button and opens nothing. */}
  <dialog class="photo-view pp-photo" id="pp-photo">
    <button type="button" class="pv-close" id="pp-photo-close" aria-label={t.photoClose}>&times;</button>
    <div class="pv-frame"><img id="pp-photo-img" alt="" /></div>
  </dialog>
  {/* Their followers or who they follow: the one sheet, the rows the
      hearts' list draws (PhotoLikers.astro), a row opens the profile. */}
  <Sheet id="pp-people" class="pl-sheet">
    <h3 class="at-sheet-h" id="pp-people-h"></h3>
    <ul class="people-list pl-list" id="pp-people-list" data-anon={t.noteVisitor}></ul>
  </Sheet>
  <Sheet id="pp-mod">
    <h3 class="at-sheet-h" id="pp-mod-h"></h3>
    <p class="at-sheet-p" id="pp-mod-p">Blocking hides them from you, and neither of you follows the other any more.</p>
    <div class="at-sheet-btns" id="pp-mod-btns">
      <button type="button" class="sheet-b sheet-b--secondary" id="pp-report">Report this person</button>
      <button type="button" class="sheet-b sheet-b--red" id="pp-block">Block this person</button>
    </div>
  </Sheet>
  <Sheet id="pp-why">
    <h3 class="at-sheet-h" id="pp-why-h">Why are you reporting this?</h3>
    <p class="at-sheet-p" id="pp-why-p" hidden>We look at every report. If you would rather not see this person at all, block them too.</p>
    <div class="at-sheet-btns" id="pp-why-btns">
      <button type="button" class="sheet-b sheet-b--secondary" data-reason="An offensive name or picture">An offensive name or picture</button>
      <button type="button" class="sheet-b sheet-b--secondary" data-reason="Pretending to be somebody else">Pretending to be somebody else</button>
      <button type="button" class="sheet-b sheet-b--secondary" data-reason="Spam or advertising">Spam or advertising</button>
      <button type="button" class="sheet-b sheet-b--secondary" data-reason="Something else">Something else</button>
    </div>
    <div class="at-sheet-btns" id="pp-why-done" hidden>
      <button type="button" class="sheet-b sheet-b--primary" id="pp-why-close">Done</button>
    </div>
  </Sheet>
  <div class="stage">
    <div id="map" class="map"></div>
  </div>
</div>
<style>
  .pp-private { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 16px; color: var(--ink-mid); }
  .pp-private :global(svg) { width: 20px; height: 20px; flex: none; }
  .pp-more { flex: none; width: 44px; height: 44px; margin-right: -10px; border: 0; background: none; color: var(--ink-mid); cursor: pointer; display: grid; place-items: center; }
  .pp-more[hidden] { display: none; }
  .pp-more :global(svg) { width: 22px; height: 22px; }
  .pp-count { border: 0; background: none; padding: 12px 0; margin: -12px 14px -12px 0; font: inherit; color: inherit; cursor: pointer; }
  .pp-count:hover b, .pp-count:focus-visible b { text-decoration: underline; }
  .pp-people-empty { margin: 0; padding: 4px 0 8px; color: var(--ink-mid); font-size: 15px; }
  .pp-empty { grid-column: 1 / -1; margin: 0; color: var(--ink-mid); font-size: 15px; }
  /* No credit bar under a face, so the picture takes the whole height. */
  .pp-photo .pv-frame { height: 100dvh; }
  button.profile-avatar { border: 0; padding: 0; cursor: zoom-in; }
  button.profile-avatar:focus-visible { outline: 3px solid var(--moss); outline-offset: 2px; }
</style>
<Fragment slot="scripts" set:html={TREE_ACTIONS_JS + myTreesMapScript() + SHEET_JS + `
<script>
(function() {
  var C = window.atCollection;
  var SB = "${SUPABASE_URL}", KEY = "${SUPABASE_KEY}";
  var SEAL = '${SEAL}';
  var UNTIL = ${JSON.stringify(EARLY_ADOPTER_UNTIL)};
  var OPEN = ${JSON.stringify(t.photoOpen)};
  function el(id) { return document.getElementById(id); }
  var uid = new URLSearchParams(location.search).get("u") || "";
  // The sheet's peek is one header tall and is measured on resize
  // (sheet-js.ts), so it is told when the header fills in after the fetch.
  function remeasure() { window.dispatchEvent(new Event("resize")); }
  function closed() { el("pp-private").hidden = false; remeasure(); }
  if (!/^[0-9a-f-]{36}$/i.test(uid)) { closed(); return; }

  // YOUR OWN NAME OPENS YOUR OWN PROFILE (Hidde, 2026-11-22), the one you can
  // edit, wherever it was tapped: a tree page's note or photo, Activity, a
  // list of followers. Instagram's and AllTrails' way. The server says who is
  // looking (hard rule 11); Settings' "See your public profile" passes
  // view=public to stay here and see what others see.
  if (C && C.verify && new URLSearchParams(location.search).get("view") !== "public") {
    C.verify().then(function(ok) {
      var s = ok && C.session();
      if (!s) return;
      fetch(SB + "/auth/v1/user", { headers: { "apikey": KEY, "Authorization": "Bearer " + s.access_token } })
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(u) { if (u && u.id && u.id.toLowerCase() === uid.toLowerCase()) location.replace("/account"); })
        .catch(function() {});
    }).catch(function() {});
  }

  fetch(SB + "/rest/v1/rpc/public_profile", {
    method: "POST",
    headers: { "apikey": KEY, "Authorization": "Bearer " + KEY, "Content-Type": "application/json" },
    body: JSON.stringify({ uid: uid })
  }).then(function(r) { return r.ok ? r.json() : null; })
    .then(function(p) { if (p && p.display_name) show(p); else closed(); })
    .catch(closed);

  function show(p) {
    document.title = p.display_name + " · Ancient Trees";
    el("pp-in").hidden = false;
    el("pp-lanes").hidden = false;
    el("pp-name").textContent = p.display_name;
    var av = el("pp-avatar");
    if (p.avatar_url) {
      var src = String(p.avatar_url).replace(/[()'"]/g, "");
      // The picture becomes the button that opens it; a letter stays a span.
      var b = document.createElement("button");
      b.type = "button";
      b.className = "profile-avatar";
      b.id = "pp-avatar";
      b.setAttribute("aria-label", OPEN);
      b.style.backgroundImage = "url(" + src + ")";
      av.replaceWith(b);
      bigger(b, src, p.display_name);
    }
    else av.textContent = p.display_name.charAt(0).toUpperCase();
    if (p.country && /^[A-Z]{2}$/.test(p.country)) {
      var img = el("pp-flag");
      img.src = "/flags/" + p.country.toLowerCase() + ".svg";
      try { img.alt = new Intl.DisplayNames(["en"], { type: "region" }).of(p.country) || p.country; } catch (e) { img.alt = p.country; }
      img.hidden = false;
    }
    el("pp-followers").textContent = p.followers || 0;
    el("pp-following").textContent = p.following || 0;
    // The badges in the app's words (AmbassadorBadge.swift, profile-js.ts).
    var names = p.ambassador || [];
    if (names.length) {
      var label = names.length === 1 ? names[0] + " ambassador"
        : names.length === 2 ? names[0] + " and " + names[1] + " ambassador"
        : names[0] + ", " + names[1] + " and " + (names.length - 2) + " more, ambassador";
      var amb = el("pp-ambassador");
      amb.innerHTML = SEAL + "<span></span>";
      amb.lastChild.textContent = label;
      amb.hidden = false;
    }
    if (p.created_at && (!UNTIL || p.created_at < UNTIL)) el("pp-early").hidden = false;
    follow(p);
    people(p.user_id);
    moderate(p);
    lists(p.visited || [], p.saves || [], p.approved || [], p.own || []);
    remeasure();
  }

  // REPORT AND BLOCK, the app's PersonActions on the web: a reports row and a
  // blocks row written with the viewer's own session (supabase/reports.sql),
  // the same English reasons, so one queue reads one language.
  function moderate(p) {
    var more = el("pp-more"), mod = el("pp-mod"), why = el("pp-why");
    var me = null, blocked = false;
    function call(s, method, path, body, prefer) {
      var h = { "apikey": KEY, "Authorization": "Bearer " + s.access_token };
      if (body) { h["Content-Type"] = "application/json"; h["Prefer"] = prefer || "return=minimal"; }
      return fetch(SB + "/rest/v1/" + path, { method: method, headers: h, body: body ? JSON.stringify(body) : undefined })
        .then(function(r) { return r.ok; }).catch(function() { return false; });
    }
    function paint() {
      var b = el("pp-block");
      b.textContent = blocked ? "Unblock this person" : "Block this person";
      b.className = "sheet-b " + (blocked ? "sheet-b--secondary" : "sheet-b--red");
    }
    C.verify().then(function(ok) {
      var s = ok && C.session();
      if (!s) { more.hidden = false; return; }
      fetch(SB + "/auth/v1/user", { headers: { "apikey": KEY, "Authorization": "Bearer " + s.access_token } })
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(u) {
          me = u && u.id;
          if (me === p.user_id) return;          // your own public profile
          more.hidden = false;
          if (!me) return;
          fetch(SB + "/rest/v1/blocks?select=blocked&blocker=eq." + me + "&blocked=eq." + p.user_id,
            { headers: { "apikey": KEY, "Authorization": "Bearer " + s.access_token } })
            .then(function(r) { return r.ok ? r.json() : []; })
            .then(function(rows) { blocked = !!(rows && rows.length); paint(); });
        });
    });
    more.addEventListener("click", function() {
      var ask = function() { if (window.atOpenSignIn) window.atOpenSignIn(); };
      if (!C || !C.gate) { ask(); return; }
      C.gate(function() {
        el("pp-mod-h").textContent = p.display_name;
        paint();
        mod.showModal();
      }, ask);
    });
    el("pp-report").addEventListener("click", function() {
      mod.close();
      el("pp-why-h").textContent = "Why are you reporting this?";
      el("pp-why-p").hidden = true; el("pp-why-btns").hidden = false; el("pp-why-done").hidden = true;
      // One sheet hands over to the next a moment later, as the app's pendingReport.
      setTimeout(function() { why.showModal(); }, 60);
    });
    el("pp-block").addEventListener("click", function() {
      C.gate(function(s) {
        if (!me) return;
        var was = blocked;
        blocked = !was; paint(); mod.close();
        var done = was
          ? call(s, "DELETE", "blocks?blocker=eq." + me + "&blocked=eq." + p.user_id)
          : call(s, "POST", "blocks?on_conflict=blocker,blocked", [{ blocker: me, blocked: p.user_id }], "resolution=merge-duplicates,return=minimal");
        done.then(function(ok) {
          if (!ok) { blocked = was; paint(); return; }
          // A block ends following both ways, so the Follow button reads again.
          if (!was) location.reload();
        });
      }, function() {});
    });
    el("pp-why-btns").addEventListener("click", function(e) {
      var b = e.target.closest && e.target.closest("[data-reason]");
      if (!b) return;
      C.gate(function(s) {
        if (!me) return;
        call(s, "POST", "reports", [{ reporter: me, subject: p.user_id, reason: b.getAttribute("data-reason") }]).then(function() {
          el("pp-why-h").textContent = "Thank you";
          el("pp-why-p").hidden = false; el("pp-why-btns").hidden = true; el("pp-why-done").hidden = false;
        });
      }, function() {});
    });
    el("pp-why-close").addEventListener("click", function() { why.close(); });
  }

  // FOLLOWERS AND FOLLOWING, from the counts (the app's followListOf). Names
  // are signed in only, so signed out the sign-in sheet asks first.
  function people(id) {
    var esc = function(s) { return String(s == null ? "" : s).replace(/[&<>"']/g, function(c) { return "&#" + c.charCodeAt(0) + ";"; }); };
    function rest(s, path) {
      return fetch(SB + "/rest/v1/" + path, { headers: { "apikey": KEY, "Authorization": "Bearer " + s.access_token } })
        .then(function(r) { return r.ok ? r.json() : []; }).catch(function() { return []; });
    }
    function open(which, s) {
      var d = el("pp-people"), list = el("pp-people-list");
      el("pp-people-h").textContent = which === "followers" ? "Followers" : "Following";
      list.innerHTML = "";
      if (!d.open) d.showModal();
      var path = which === "followers"
        ? "follows?select=follower&followee=eq." + id + "&limit=200"
        : "follows?select=followee&follower=eq." + id + "&limit=200";
      var key = which === "followers" ? "follower" : "followee";
      rest(s, path).then(function(rows) {
        var ids = (rows || []).map(function(r) { return r[key]; }).filter(Boolean);
        if (!ids.length) {
          list.innerHTML = '<li class="pp-people-empty">' + (which === "followers" ? "No followers yet." : "Not following anybody yet.") + "</li>";
          return;
        }
        rest(s, "profiles?select=user_id,display_name,avatar_url&user_id=in.(" + ids.join(",") + ")").then(function(ps) {
          var by = {}; (ps || []).forEach(function(p) { by[p.user_id] = p; });
          var anon = list.getAttribute("data-anon") || "";
          list.innerHTML = ids.map(function(u) {
            var p = by[u] || { user_id: u };
            var name = p.display_name || anon;
            var av = p.avatar_url && /^https:/.test(p.avatar_url)
              ? '<span class="people-av" style="background-image:url(' + esc(String(p.avatar_url).replace(/[()'"]/g, "")) + ')"></span>'
              : '<span class="people-av">' + esc(name.charAt(0).toUpperCase()) + "</span>";
            var inner = av + '<span class="people-name' + (p.display_name ? "" : " none") + '">' + esc(name) + "</span>";
            return "<li>" + (p.display_name
              ? '<a class="people-who" href="/profile?u=' + encodeURIComponent(u) + '">' + inner + "</a>"
              : '<span class="people-who">' + inner + "</span>") + "</li>";
          }).join("");
        });
      });
    }
    document.querySelectorAll(".pp-count").forEach(function(b) {
      b.addEventListener("click", function() {
        var which = b.getAttribute("data-list");
        var ask = function() { if (window.atOpenSignIn) window.atOpenSignIn(); };
        if (!C || !C.gate) { ask(); return; }
        C.gate(function(s) { open(which, s); }, ask);
      });
    });
  }

  function bigger(btn, src, name) {
    var d = el("pp-photo"), img = el("pp-photo-img");
    d.setAttribute("aria-label", name);
    img.alt = name;
    btn.addEventListener("click", function() { if (!img.src) img.src = src; d.showModal(); });
    el("pp-photo-close").addEventListener("click", function() { d.close(); });
    // A click on the dialog itself is a click beside the picture.
    d.addEventListener("click", function(e) { if (e.target === d || e.target.classList.contains("pv-frame")) d.close(); });
    // Drag down to close, the gesture a thumb reaches for first (PhotoFigure).
    var y0 = null;
    d.addEventListener("touchstart", function(e) { y0 = e.touches[0].clientY; }, { passive: true });
    d.addEventListener("touchmove", function(e) {
      if (y0 === null) return;
      var dy = e.touches[0].clientY - y0;
      if (dy > 0) d.style.transform = "translateY(" + Math.min(dy, 240) + "px)";
    }, { passive: true });
    d.addEventListener("touchend", function(e) {
      var dy = y0 === null ? 0 : e.changedTouches[0].clientY - y0;
      d.style.transform = "";
      y0 = null;
      if (dy > 90) d.close();
    }, { passive: true });
  }

  // FOLLOW, the app's PeopleView button on the web: a follows row written
  // with the viewer's own session (supabase/profiles.sql), behind the one gate.
  function follow(p) {
    var btn = el("pp-follow");
    var following = false;
    function paint() {
      btn.textContent = following ? "Following" : "Follow";
      btn.classList.toggle("on", following);
      btn.setAttribute("aria-pressed", following ? "true" : "false");
    }
    function api(s, method, path, body) {
      var h = { "apikey": KEY, "Authorization": "Bearer " + s.access_token };
      if (body) { h["Content-Type"] = "application/json"; h["Prefer"] = "return=minimal"; }
      return fetch(SB + path, { method: method, headers: h, body: body ? JSON.stringify(body) : undefined });
    }
    var me = null;
    C.verify().then(function(ok) {
      var s = ok && C.session();
      if (!s) { btn.hidden = false; paint(); return; }
      fetch(SB + "/auth/v1/user", { headers: { "apikey": KEY, "Authorization": "Bearer " + s.access_token } })
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(u) {
          me = u && u.id;
          if (me === p.user_id) return;          // your own public profile
          btn.hidden = false; paint();
          if (!me) return;
          api(s, "GET", "/rest/v1/follows?select=followee&follower=eq." + me + "&followee=eq." + p.user_id)
            .then(function(r) { return r.ok ? r.json() : []; })
            .then(function(rows) {
              following = !!(rows && rows.length); paint();
              // Signed in from this Follow: finish it, as a save is finished
              // after its sign-in (signin-js landed()). The button saying
              // Following is the acknowledgement; no toast.
              if (window.atPendingFollow === p.user_id && !following) toggle(s);
              window.atPendingFollow = null;
            });
        });
    });
    function toggle(s) {
      if (!me || me === p.user_id) return;
      btn.disabled = true;
      var req = following
        ? api(s, "DELETE", "/rest/v1/follows?follower=eq." + me + "&followee=eq." + p.user_id)
        : api(s, "POST", "/rest/v1/follows", { follower: me, followee: p.user_id });
      req.then(function(r) {
        btn.disabled = false;
        if (!r.ok) return;
        var n = el("pp-followers");
        n.textContent = Math.max(0, parseInt(n.textContent, 10) + (following ? -1 : 1));
        following = !following; paint();
      }).catch(function() { btn.disabled = false; });
    }
    btn.addEventListener("click", function() {
      // Signed out, the sheet names the person (it said "Sign in to have
      // your say" until 2026-10-28, the vote's wording).
      C.gate(toggle, function() {
        if (window.atOpenSignIn) window.atOpenSignIn(p.display_name, "follow", { kind: "follow", user: p.user_id });
      });
    });
  }

  // THE TWO LISTS AND THE MAP, the account page's own: ids from the server,
  // what each tree is from /api/cards.json, the one card.
  // approved: our trees this person ADDED (Approved top-left, the app's
  // MineCard capsule). own: the trees they added that are not in our
  // selection, shown beside the rest with their shared photograph and
  // their pin (Hidde, 2026-11-12; CONVENTIONS.md
  // "Your own trees on a public profile"). Both come from public_profile()
  // (supabase/approved-on-profiles.sql) and are empty until that is pasted.
  function esc(t) { return String(t == null ? "" : t).replace(/[&"<>]/g, function(c) {
    return { "&": "&amp;", '"': "&quot;", "<": "&lt;", ">": "&gt;" }[c]; }); }
  function ownTile(o) {
    var name = o.name || String(o.species || "").split("(")[0].trim() || "A tree";
    // The tile loads the small copy (scripts/shared_thumbs.py, 2026-11-13,
    // Supabase egress); one shared since the last knock has none yet and
    // falls back to the full copy, which the tree's /t page always shows.
    var path = String(o.photo).split("/").map(encodeURIComponent).join("/");
    var full = SB + "/storage/v1/object/public/shared-sightings/" + path;
    var src = SB + "/storage/v1/object/public/shared-thumbs/" + path;
    return '<li><article class="tree-card tree-card-nonum tree-card-link" data-pin-id="own-' + esc(String(o.id)) + '">'
      + '<div class="tree-card-photo"><img src="' + esc(src) + '" data-full="' + esc(full) + '" alt="' + esc(name) + '" loading="lazy"></div>'
      + '<div class="tree-card-top"><h3 class="tree-name"><a href="/t?id=' + encodeURIComponent(String(o.id).toLowerCase())
      + '">' + esc(name) + '</a></h3></div></article></li>';
  }
  document.addEventListener("error", function(e) {
    var img = e.target;
    if (img && img.tagName === "IMG" && img.dataset && img.dataset.full && img.src !== img.dataset.full) {
      img.src = img.dataset.full;
    }
  }, true);
  function lists(visited, saves, approved, own) {
    var isApproved = {};
    approved.forEach(function(id) { isApproved[id] = true; });
    C.catalogue().then(function(cards) {
      function fill(listId, emptyId, ids, extra) {
        var known = ids.filter(function(id) { return cards[id]; });
        var node = el(listId);
        if (!known.length && !extra) { el(emptyId).hidden = false; return; }
        node.innerHTML = known.map(function(id) {
          var city = String(cards[id].c || "").replace(/[&"<>]/g, "");
          var chip = isApproved[id] ? '<span class="appr-chip">' + SEAL + 'Approved</span>' : '';
          return '<li' + (city ? ' data-city="' + city + '"' : '') + '>' + chip + C.card(id, cards[id], false, false) + '</li>';
        }).join("") + (extra || "");
        node.hidden = false;
        if (window.atPaintSaves) window.atPaintSaves();
      }
      fill("visited-list", "mine-empty", visited, own.map(ownTile).join(""));
      fill("saved-list", "saved-empty", saves);
      if (!window.atSetMyTrees) return;
      var got = {}, savedIds = {};
      visited.forEach(function(id) { got[id] = true; });
      saves.forEach(function(id) { savedIds[id] = true; });
      var all = visited.concat(saves.filter(function(id) { return !got[id]; }));
      window.atSetMyTrees(all.filter(function(id) {
        var c = cards[id]; return c && typeof c.x === "number" && typeof c.y === "number";
      }).map(function(id) {
        var c = cards[id];
        return { type: "Feature", geometry: { type: "Point", coordinates: [c.x, c.y] },
                 properties: { id: id, name: c.n, city: c.c || "", url: c.u, ic: c.ic, got: got[id] ? 1 : 0,
                               saved: savedIds[id] ? 1 : 0 } };
      }).concat(own.filter(function(o) { return typeof o.lat === "number" && typeof o.lng === "number"; })
        .map(function(o) {
          return { type: "Feature", geometry: { type: "Point", coordinates: [o.lng, o.lat] },
                   properties: { id: "own-" + String(o.id), name: o.name || "A tree", city: "", url: "/t?id=" + String(o.id).toLowerCase(), got: 1 } };
        })));
    });
  }

  var lanes = [["lane-mine", "pane-mine"], ["lane-saved", "pane-saved"]];
  lanes.forEach(function(pair) {
    el(pair[0]).addEventListener("click", function() {
      lanes.forEach(function(other) {
        var on = other[0] === pair[0];
        el(other[0]).classList.toggle("on", on);
        el(other[0]).setAttribute("aria-selected", on ? "true" : "false");
        el(other[1]).hidden = !on;
      });
    });
  });
})();
</script>
