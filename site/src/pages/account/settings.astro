---
// Settings: the admin, one click behind the profile.
//
// Hidde, 2026-09-02: "settings een knop dieper". In the app this is
// Profile.swift, a pushed screen reached from the gear on My trees, and its
// order is the conventional one every reference shares (AllTrails, Komoot,
// Airbnb, Strava): who you are, then what you can change, then the quiet
// links, and only at the very bottom sign out and delete.
//
// It used to be a card at the foot of /account, which meant the two most
// destructive controls in the product sat on the page somebody lands on to
// look at their own trees. That is the exact fault Hidde found in the app on
// 2026-08-21 ("my first button I see is to sign out or delete accounts"), and
// the website had it for another fortnight.
//
// Deletion keeps its own marked area at the foot, per CONVENTIONS.md "How a
// settings page is built, and where deleting an account sits": GitHub's Danger
// Zone, Strava's Delete Your Account at the foot of My Account. The
// both-surfaces rule asks that the BEHAVIOUR match, which is that deletion
// costs a second deliberate step, not that the design match.
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { BASE_URL } from "../../lib/schema";
import Sheet from "../../components/Sheet.astro";
import PlusAsk from "../../components/PlusAsk.astro";
import { switchOn } from "../../lib/switches";
// The Plus row follows data/app-switches.json, as the app does.
const plusOn = switchOn("plus_ask");
import { icon } from "../../lib/icons";
import { DOWNSIZE_JS } from "../../lib/image-downsize-js";
import ProfileEditor from "../../components/ProfileEditor.astro";
import { PROFILE_EDITOR_JS } from "../../lib/profile-editor-js";
import { SUPABASE_URL, SUPABASE_KEY } from "../../lib/site-config";
import { COUNTRY_JS } from "../../lib/countries";

const canonical = `${BASE_URL}/account/settings`;
const crumbItems: [string, string | null][] = [
  ["Your trees", `${BASE_URL}/account`],
  ["Settings", null],
];
---
<Base
  title="Settings"
  description="Your account, and what we hold."
  canonical={canonical}
  headExtra='<meta name="robots" content="noindex, nofollow">'
>
<main class="content-page account-page">
  <Breadcrumbs items={crumbItems} />
  <h1>Settings</h1>

  {/* THE APP'S OWN ORDER (Hidde, 2026-09-17: "moet exact hetzelfde eruit zien
      als app"). Screens/Profile.swift carries it and says why: who you are,
      then what you can DO, then the quiet links, and only at the very bottom,
      after everything else, sign out and delete.

      What this page had instead: one card, then sign out as a small underlined
      link and delete folded into a <details>. Two destructive controls dressed
      as footnotes, which is the opposite of the app, where each is a full row
      in a card of its own and delete is red. */}
  <p id="set-out" class="acct-sub" hidden>You are not signed in. <a href="/account">Sign in</a> to change anything here.</p>

  {/* ONE SCREEN WITH THE APP (Hidde, 2026-10-10: "make that settings things
      more consistent with the app", then "some ux things have different
      conventions for web app use those"). iOS Settings' shape on both:
      your card at the top, which opens your name and picture; Preferences;
      Help; About; then Sign out and Delete account. The web's own
      conventions where they differ: a choice is a native dropdown rather than
      an iOS menu, editing your name and picture is a sheet over the page
      (X's and Instagram's web "Edit profile"), the Directions row shows only
      on an iPhone because only there do we hand a route to an app, and there
      is no Rate the app. Every question is the one sheet (Sheet.astro). */}
  <section id="set-in" hidden>
    <button type="button" class="set-me" id="me-open" aria-haspopup="dialog">
      <span class="profile-avatar set-me-av" id="me-av" aria-hidden="true"></span>
      <span class="set-me-who"><b id="me-name">Your account</b><span id="set-email"></span></span>
      <Fragment set:html={icon("caret-right", "bold", "ic set-go")} />
    </button>

    <p class="acct-group">Preferences</p>
    <div class="acct-rows">
      <label class="set-row" id="st-units" hidden>
        <Fragment set:html={icon("ruler", "bold", "ic set-ic")} /><span class="set-label">Distances</span>
        <span class="set-val"><select id="units-sel" class="set-select" aria-label="Distances">
          <option value="km">Kilometers</option><option value="mi">Miles</option>
        </select><Fragment set:html={icon("caret-up-down", "bold", "ic set-caret")} /></span>
      </label>
      <label class="set-row" id="st-dir" hidden>
        <Fragment set:html={icon("arrow-bend-up-right", "bold", "ic set-ic")} /><span class="set-label">Directions</span>
        <span class="set-val"><select id="dir-sel" class="set-select" aria-label="Directions">
          <option value="">Ask each time</option><option value="apple">Apple Maps</option><option value="google">Google Maps</option>
        </select><Fragment set:html={icon("caret-up-down", "bold", "ic set-caret")} /></span>
      </label>
      {/* PRIVACY SETTINGS, one row among the others (Hidde, 2026-10-19: "is
          het benchmark dat dit bovenaan je settings staat?"). AllTrails:
          Profile, gear, "Privacy Settings", its own screen; Polarsteps:
          Settings, "Account type". Hidden until profiles.public answers. */}
      <button type="button" class="set-row" id="priv-open" hidden aria-haspopup="dialog">
        <Fragment set:html={icon("lock-simple", "bold", "ic set-ic")} /><span class="set-label">Privacy settings</span>
        <span class="set-val" id="priv-val" data-on="Public" data-off="Only me">Only me</span><Fragment set:html={icon("caret-right", "bold", "ic set-go")} />
      </button>
    </div>

    <p class="acct-group">Help</p>
    <div class="acct-rows">
      {/* The Plus question, first in Help as in the app's Settings (Hidde,
          2026-11-05: "bouw ook"); PlusAsk below carries the sheet. */}
{plusOn && (      <button type="button" class="set-row plus-row" data-from="settings"><Fragment set:html={icon("sparkle", "fill", "ic set-ic")} /><span class="set-label">Ancient Trees Plus</span><Fragment set:html={icon("caret-right", "bold", "ic set-go")} /></button>)}
      <a class="set-row" href="/contribute?kind=feedback"><Fragment set:html={icon("chat-circle", "bold", "ic set-ic")} /><span class="set-label">Send feedback</span><Fragment set:html={icon("caret-right", "bold", "ic set-go")} /></a>    </div>

    <p class="acct-group">About</p>
    <div class="acct-rows">
      <a class="set-row" href="/privacy"><Fragment set:html={icon("lock-simple", "bold", "ic set-ic")} /><span class="set-label">Privacy</span><Fragment set:html={icon("caret-right", "bold", "ic set-go")} /></a>
      <a class="set-row" href="/terms"><Fragment set:html={icon("file-text", "bold", "ic set-ic")} /><span class="set-label">Terms</span><Fragment set:html={icon("caret-right", "bold", "ic set-go")} /></a>
      <a class="set-row" href="/sources"><Fragment set:html={icon("book-open", "bold", "ic set-ic")} /><span class="set-label">Sources</span><Fragment set:html={icon("caret-right", "bold", "ic set-go")} /></a>
    </div>

    {/* ONE ACCOUNT GROUP (Hidde, 2026-11-04, the app's Settings with it): Sign
        out acts here, so no chevron; Delete account opens the screen that
        explains, so it keeps one, in grey. The red waits on that screen. */}
    <p class="acct-group">Account</p>
    <div class="acct-rows">
      <button type="button" id="signout" class="set-row set-row-plain">Sign out</button>
      <button type="button" id="del-open" class="set-row set-row-plain set-quiet">Delete account<Fragment set:html={icon("caret-right", "bold", "ic set-go")} /></button>
    </div>
  </section>

  {/* YOUR NAME AND PICTURE, the app's ProfileEditor as a sheet. The file input
      behind a button is the web's picker for the app's PhotosPicker
      (CONVENTIONS.md); the 512px JPEG, the avatars/<user-id>/avatar.jpg and
      the profiles row are the app's, unchanged. */}
  {/* Your picture, name and country: the one editor, shared with /account. */}
  <ProfileEditor />

  {/* PRIVACY SETTINGS, the one sheet (Sheet.astro) with two steps, as the
      ambassador sheet has: the switch, and turning it on asks first and says
      what becomes visible. Turning it off is one tap and asks nothing. */}
  <Sheet id="priv-sheet" aria-labelledby="priv-h">
    <div class="priv-step" data-step="set">
      <h3 class="at-sheet-h" id="priv-h">Privacy settings</h3>
      <div class="acct-rows priv-rows">
        <button type="button" class="set-row" id="priv-row" role="switch" aria-checked="false">
          <Fragment set:html={icon("globe-hemisphere-east", "bold", "ic set-ic")} /><span class="set-label">Public profile</span><span class="set-switch" aria-hidden="true"></span>
        </button>
      </div>
      <p class="set-foot" id="priv-foot" data-on="Anyone can see your profile and your trees." data-off="Only you see your profile.">Only you see your profile.</p>
      <p class="set-foot" id="priv-link" hidden><a href="/account">See your public profile</a></p>
    </div>
    <div class="priv-step" data-step="ask" hidden>
      <span class="at-sheet-tile"><Fragment set:html={icon("globe-hemisphere-east", "bold")} /></span>
      <h3 class="at-sheet-h">Make your profile public?</h3>
      <p class="at-sheet-p">Anyone can then open it, with or without an account.</p>
      <ul class="at-sheet-pts">
        <li><Fragment set:html={icon("check", "bold")} />Your name and picture</li>
        <li><Fragment set:html={icon("check", "bold")} />The trees you collected and want to visit</li>
        <li><Fragment set:html={icon("check", "bold")} />Your badges</li>
      </ul>
      <div class="at-sheet-btns">
        <button type="button" id="pub-yes" class="sheet-b sheet-b--primary">Make public</button>
        <button type="button" id="pub-no" class="sheet-b sheet-b--quiet">Not now</button>
      </div>
    </div>
  </Sheet>

  <Sheet id="out-sheet" aria-labelledby="out-h">
    <h3 class="at-sheet-h" id="out-h">Sign out?</h3>
    <p class="at-sheet-p">Your collection stays in your account. Sign in again on any device and it comes back.</p>
    <div class="at-sheet-btns">
      <button type="button" id="out-yes" class="sheet-b sheet-b--red">Sign out</button>
      <button type="button" id="out-no" class="sheet-b sheet-b--secondary">Cancel</button>
    </div>
  </Sheet>

  {/* ASKED TWICE, the second one TYPED (the app's rule, 2026-08-31), now in the
      one sheet rather than a pink panel opened on the page. The app's delete
      screen, sentence for sentence. */}
  <Sheet id="del-sheet" aria-labelledby="del-h">
    <h3 class="at-sheet-h" id="del-h">Delete your account?</h3>
    <p class="at-sheet-p">We hold your email address, the name, picture and country you chose, and the trees you have saved, collected and photographed. You can delete all of it from this screen.</p>
    <p class="at-sheet-p">We will delete your email address and your collection. You cannot undo this.</p>
    <p class="at-sheet-p">To use a different address, write to <a href="mailto:info@ancienttrees.app">info@ancienttrees.app</a> and we will move your collection across.</p>
    <div class="set-edit">
      <label for="del-confirm" class="set-edit-label">Type DELETE to confirm</label>
      <input id="del-confirm" type="text" autocomplete="off" autocapitalize="characters" placeholder="DELETE" />
    </div>
    <div class="at-sheet-btns">
      <button type="button" id="del-acct" class="sheet-b sheet-b--red" disabled>Delete account</button>
      <button type="button" id="del-no" class="sheet-b sheet-b--secondary">Cancel</button>
    </div>
  </Sheet>
</main>
<Fragment slot="scripts" set:html={COUNTRY_JS + DOWNSIZE_JS + PROFILE_EDITOR_JS + `
<script>
(function() {
  var SB = "${SUPABASE_URL}", KEY = "${SUPABASE_KEY}";
  var myId = null;
  function session() {
    try {
      var s = JSON.parse(localStorage.getItem("ancienttrees_session"));
      return (s && s.access_token && s.expires_at > Date.now() / 1000) ? s : null;
    } catch (e) { return null; }
  }
  function signedOut() {
    document.getElementById("set-in").hidden = true;
    document.getElementById("set-out").hidden = false;
  }
  var s = session();
  if (!s) {
    signedOut();
    // A spent token renewed after this ran (signin-js window.atRefreshing):
    // once renewed, the page starts again signed in (2026-11-17).
    window.addEventListener("load", function() {
      if (window.atRefreshing) Promise.resolve(window.atRefreshing).catch(function() {}).then(function() {
        if (session()) location.reload();
      });
    });
    return;
  }
  document.getElementById("set-in").hidden = false;

  fetch(SB + "/auth/v1/user", { headers: { "apikey": KEY, "Authorization": "Bearer " + s.access_token } })
    .then(function(r) { return r.ok ? r.json() : null; })
    .then(function(u) {
      if (!u) return;
      if (u.email) {
        document.getElementById("set-email").textContent = u.email;
        document.getElementById("me-name").textContent = u.email.split("@")[0];
        // A letter rather than an empty circle while we find out whether
        // there is a picture, which is what the profile head already does.
        initial(u.email);
      }
      if (!u.id) return;
      myId = u.id;
      // The name they already chose, wherever they chose it. An empty box on a
      // page that already knows the answer reads as data lost, and somebody who
      // set their name in the app would be looking at exactly that.
      //
      // Units ride along on the same row rather than a second request: the app
      // reads and writes the one profiles row and so does this page.
      fetch(SB + "/rest/v1/profiles?select=display_name,avatar_url,units&user_id=eq." + encodeURIComponent(u.id),
            { headers: { "apikey": KEY, "Authorization": "Bearer " + s.access_token } })
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(rows) {
          if (!rows) return;               // no column, no switch
          if (rows[0] && rows[0].display_name) {
            document.getElementById("me-name").textContent = rows[0].display_name;
            initial(rows[0].display_name);
          }
          if (rows[0] && rows[0].avatar_url) {
            showPicture(rows[0].avatar_url);
          }
          units(rows[0] ? rows[0].units : null);
        }).catch(function() {});
      // PRIVATE PROFILE, read on its own like the country, so a database
      // without profiles.public yet costs the switch and nothing else.
      fetch(SB + "/rest/v1/profiles?select=public,display_name&user_id=eq." + encodeURIComponent(u.id),
            { headers: { "apikey": KEY, "Authorization": "Bearer " + s.access_token } })
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(rows) { if (rows) privacy(rows[0] || null); })
        .catch(function() {});
    }).catch(function() {});

  // The switch reads "Public profile", so ON is public (Hidde, 2026-10-19:
  // "Private profile is heel negatief"; AllTrails words it Public first).
  // profiles.public, stored on the server so the phone and the laptop agree
  // (hard rule 11).
  var isPublic = false, hasName = false;
  function paintPrivacy() {
    var row = document.getElementById("priv-row");
    var foot = document.getElementById("priv-foot");
    row.setAttribute("aria-checked", isPublic ? "true" : "false");
    foot.textContent = foot.getAttribute(isPublic ? "data-on" : "data-off");
    var val = document.getElementById("priv-val");
    val.textContent = val.getAttribute(isPublic ? "data-on" : "data-off");
    var link = document.getElementById("priv-link");
    link.hidden = !isPublic;
    // view=public: you asked to see what others see, so profile.astro does
    // not send you back to your own editable profile.
    if (myId) link.firstChild.href = "/profile?u=" + encodeURIComponent(myId) + "&view=public";
  }
  function writePublic(want, done) {
    var cur = session();
    if (!cur || !myId) return;
    fetch(SB + "/rest/v1/profiles?user_id=eq." + encodeURIComponent(myId), {
      method: "PATCH",
      headers: { "apikey": KEY, "Authorization": "Bearer " + cur.access_token,
                 "Content-Type": "application/json", "Prefer": "return=minimal" },
      body: JSON.stringify({ public: want })
    }).then(function(r) { if (r.ok) { isPublic = want; paintPrivacy(); } if (done) done(r.ok); })
      .catch(function() { if (done) done(false); });
  }
  function privacy(row) {
    document.getElementById("priv-open").hidden = false;
    isPublic = Boolean(row && row.public);
    hasName = Boolean(row && row.display_name);
    paintPrivacy();
  }
  function step(name) {
    document.querySelectorAll("#priv-sheet .priv-step").forEach(function(d) {
      d.hidden = d.getAttribute("data-step") !== name;
    });
  }
  document.getElementById("priv-open").addEventListener("click", function() { step("set"); open("priv-sheet"); });
  document.getElementById("priv-row").addEventListener("click", function() {
    if (isPublic) { writePublic(false); return; }
    // A public profile needs a name to show: no profiles row exists until
    // somebody sets one (supabase/profiles.sql), so the name comes first.
    if (!hasName) { shut("priv-sheet"); window.atProfileEditor.open("Add a name first; it is what your public profile shows."); return; }
    step("ask");
  });
  document.getElementById("pub-yes").addEventListener("click", function() {
    var b = this; b.disabled = true;
    writePublic(true, function() { b.disabled = false; step("set"); });
  });
  document.getElementById("pub-no").addEventListener("click", function() { step("set"); });

  // KILOMETRES OR MILES, the same profiles.units the app writes, so the choice
  // follows somebody between the phone and the laptop. The row stays hidden
  // until that column answers: a control that looks like a setting and stores
  // nothing is worse than no control, and the site still reads in the right
  // units meanwhile because units-js decides from where the reader is.
  function units(now) {
    var box = document.getElementById("st-units");
    var sel = document.getElementById("units-sel");
    if (!box || !sel) return;
    box.hidden = false;
    if (now === "km" || now === "mi") sel.value = now;
    sel.addEventListener("change", function() {
      var want = sel.value, cur = session();
      if (!cur || !myId) return;
      fetch(SB + "/rest/v1/profiles?on_conflict=user_id", {
        method: "POST",
        headers: { "apikey": KEY, "Authorization": "Bearer " + cur.access_token,
                   "Content-Type": "application/json",
                   "Prefer": "resolution=merge-duplicates,return=minimal" },
        body: JSON.stringify([{ user_id: myId, units: want }])
      }).catch(function() {});
    });
  }

  // DIRECTIONS, on an iPhone only: the one place this site hands a route to an
  // app, the same at_maps_app key the tree page's picker remembers
  // (tree-page-js.ts). A laptop always opens Google Maps, so the row would be
  // a choice that changes nothing there.
  (function() {
    var ua = navigator.userAgent || "";
    var isIOS = /iPhone|iPad|iPod/.test(ua) || (ua.indexOf("Macintosh") > -1 && navigator.maxTouchPoints > 1);
    var row = document.getElementById("st-dir"), sel = document.getElementById("dir-sel");
    if (!isIOS || !row || !sel) return;
    row.hidden = false;
    try { sel.value = localStorage.getItem("at_maps_app") || ""; } catch (e) {}
    sel.addEventListener("change", function() {
      try {
        if (sel.value) localStorage.setItem("at_maps_app", sel.value);
        else localStorage.removeItem("at_maps_app");
      } catch (e) {}
    });
  })();

  function open(id) { var d = document.getElementById(id); if (d && d.showModal) d.showModal(); }
  function shut(id) { var d = document.getElementById(id); if (d && d.open) d.close(); }
  document.getElementById("me-open").addEventListener("click", function() { window.atProfileEditor.open(); });

  // YOUR CARD's face and name. The editing itself is ProfileEditor's
  // (lib/profile-editor-js.ts); a save there repaints the card here.
  var meAv = document.getElementById("me-av");
  function initial(name) {
    if (meAv && !meAv.style.backgroundImage) meAv.textContent = (name || "?").charAt(0).toUpperCase();
  }
  function showPicture(url) {
    if (!meAv || !url) return;
    meAv.textContent = ""; meAv.style.backgroundImage = "url(" + String(url).replace(/[()'"]/g, "") + ")";
  }
  document.addEventListener("at-profile", function(e) {
    var d = e.detail || {};
    if (d.name) { document.getElementById("me-name").textContent = d.name; hasName = true; initial(d.name); }
    showPicture(d.avatar);
  });

  var outBtn = document.getElementById("signout");
  outBtn.addEventListener("click", function() { open("out-sheet"); });
  document.getElementById("out-no").addEventListener("click", function() { shut("out-sheet"); });
  document.getElementById("out-yes").addEventListener("click", function() {
    var cur = session();
    if (cur) fetch(SB + "/auth/v1/logout", { method: "POST",
      headers: { "apikey": KEY, "Authorization": "Bearer " + cur.access_token } }).catch(function() {});
    try { localStorage.removeItem("ancienttrees_session"); } catch (e) {}
    // Signing out takes everything off the screen, because everything lives in
    // the account now: there is nothing left on the device to clear.
    //
    // AND IT LEAVES YOU WHERE YOU ARE (2026-09-18). It used to send you to
    // /account, which for somebody who has just signed out is the sign-in form:
    // the last thing signing out did was ask you to sign in again. Our own app
    // does the conventional thing already, swapping the row under your finger
    // to "Sign in" and leaving you on the screen you were reading, and this is
    // that. The change of state IS the acknowledgement, which is the pattern
    // this project uses everywhere rather than a toast (CONVENTIONS.md,
    // landing after you have added something).
    shut("out-sheet");
    var out = document.getElementById("set-out");
    out.innerHTML = 'You are signed out. <a href="/account">Sign in</a> to get your trees back.';
    signedOut();
    // The bar swapped itself on load and nothing has reloaded, so it would
    // still be claiming you are signed in. Base owns that painting in both
    // directions, so this asks rather than repeating it.
    if (window.atPaintNav) window.atPaintNav(false);
    try { localStorage.removeItem("ancienttrees_pending"); } catch (e) {}
    try { at.track("signout"); } catch (e) {}
  });

  // Account deletion: calls the delete_user() SECURITY DEFINER function in
  // Supabase (runs as owner, deletes the auth.users row for auth.uid() only).
  // Two deliberate clicks; no dialog dependency.
  // ASKED TWICE, the second one TYPED, which is what the app does
  // (Screens/Profile.swift, 2026-08-31). This page used to arm the same button
  // twice in the same place, which is one act repeated rather than two acts.
  var delOpen = document.getElementById("del-open");
  var delConfirm = document.getElementById("del-confirm");
  var delBtn = document.getElementById("del-acct");
  delOpen.addEventListener("click", function() { open("del-sheet"); delConfirm.focus(); });
  document.getElementById("del-no").addEventListener("click", function() { shut("del-sheet"); });
  delConfirm.addEventListener("input", function() {
    delBtn.disabled = delConfirm.value.trim().toUpperCase() !== "DELETE";
  });
  // THE FILES FIRST, from here rather than from the SQL, which is the app's own
  // order and its reason (Account.deleteAccount, supabase/delete-user.sql):
  // everything in the database cascades off auth.users, and a file in storage
  // does not, because Supabase refuses a delete against storage.objects from
  // SQL outright. So the client removes them through the Storage API, as the
  // account itself, in the moment before the row goes.
  //
  // Never guarded, deliberately, and the app says why: an orphaned image is a
  // tidy-up job, an account that will not delete is a broken promise.
  //
  // The avatar half is new work, because until today the website could not
  // make an avatar. The sightings half was a real gap: photographs taken in the
  // app sat under the account's own folder, and deleting that account from the
  // WEBSITE left every one of them in the bucket while /privacy promised
  // otherwise. Same promise, same handler, so it is closed here too.
  //
  // THE TREES STAY (Hidde, 2026-11-12: "het hele idee is toch dat we de bomen
  // houden als mensen hun account verwijderen", and of a tree we have not
  // approved yet: "als we een boom niet approven maar nog 2 andere m aanmelden
  // we m alsnog goed kunnen keuren"). So only the face goes from here; the
  // photographs of trees stay in the private bucket, unlinked, and the knock
  // takes their public copies down (scripts/sightings_link.py,
  // drop_public_copies_of_gone_accounts). /privacy and /terms say so.
  function purgeFiles(token, done) {
    if (!myId) { done(); return; }
    var uid = encodeURIComponent(myId);
    fetch(SB + "/storage/v1/object/avatars/" + uid + "/avatar.jpg",
          { method: "DELETE", headers: { "apikey": KEY, "Authorization": "Bearer " + token } })
      .catch(function() {}).then(done, done);
  }

  delBtn.addEventListener("click", function() {
    if (delConfirm.value.trim().toUpperCase() !== "DELETE") return;
    var cur = session();
    if (!cur) { location.href = "/account"; return; }
    delBtn.disabled = true;
    purgeFiles(cur.access_token, function() { deleteAccount(cur); });
  });

  function deleteAccount(cur) {
    fetch(SB + "/rest/v1/rpc/delete_user", { method: "POST",
      headers: { "apikey": KEY, "Authorization": "Bearer " + cur.access_token,
                 "Content-Type": "application/json" }, body: "{}" })
      .then(function(r) {
        if (r.ok) {
          try { localStorage.removeItem("ancienttrees_session"); } catch (e) {}
          // IN PLACE, for the same reason signing out is (above): sending
          // somebody who has just deleted their account to the sign-in form is
          // the wrong last word, and it is the same page they would have to
          // read to understand what happened.
          var gone = document.getElementById("set-out");
          gone.textContent = "Your account is deleted, with everything it held. Nothing of yours is left here.";
          signedOut();
          if (window.atPaintNav) window.atPaintNav(false);
        } else {
          delBtn.disabled = false;
          delBtn.textContent = "Deletion failed. Try again, or email us via the privacy page.";
        }
      })
      .catch(function() {
        delBtn.disabled = false;
        delBtn.textContent = "Deletion failed (network). Try again.";
      });
  }
})();
</script>
